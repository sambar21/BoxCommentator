# Copy to .env (which is gitignored) and fill in. Never put real keys in this file: it is committed.

# ── LLM API Keys ──────────────────────────────────────────────────────────────
# Groq (free tier, default): https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Nebius Token Factory (OpenAI-compatible, pay as you go): https://tokenfactory.nebius.com
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Model id from the Token Factory catalog (used by the `nebius` backend in config/backends.yaml)
NEBIUS_MODEL=
# Bigger model used only to write fine-tuning examples (backend `nebius-teacher`); not benchmarked
NEBIUS_TEACHER_MODEL=

# Self-hosted vLLM server (Kaggle tunnel URL, or http://localhost:8000/v1 when run in the same notebook)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY

# OpenAI (also used for embeddings when OPENAI_API_KEY is set)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Which backend the running service uses: a name from config/backends.yaml, or groq/claude/openai/ollama
COMMENTARY_BACKEND=groq

# ── TTS ───────────────────────────────────────────────────────────────────────
ELEVEN_API_KEY=your_elevenlabs_api_key_here

# ── Database (pgvector) ───────────────────────────────────────────────────────
# Docker default, change for external Postgres
DATABASE_URL=postgresql://postgres:boxio@localhost:5432/boxio
