# ── LLM API Keys ──────────────────────────────────────────────────────────────
# Groq (free, default): https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenAI (also used for embeddings when OPENAI_API_KEY is set)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── TTS ───────────────────────────────────────────────────────────────────────
ELEVEN_API_KEY=your_elevenlabs_api_key_here

# ── Database (pgvector) ───────────────────────────────────────────────────────
# Docker default — change for external Postgres
DATABASE_URL=postgresql://postgres:boxio@localhost:5432/boxio
